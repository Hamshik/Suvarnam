{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug suvarnam with LLDB",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "${workspaceFolder}/test/test.sa",
                "-o",
                "${workspaceFolder}/output/test",
                "--emit-ir",
                "${workspaceFolder}/output/test.ll"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "terminal": "integrated",
            "postDebugTask": "Run Output Test"
        }
    ],
    "justMyCode": true

}