fn void foo(var str... args, var i32... ints, var str... strs) {
    var str first = args[0];
    printf("Fist element is....: %s\n",first);
    for (item in args) {
        var str copy = item;
        printf("%s\n", copy);
    }
    for (item in strs) {
        var str copy = item;
        printf("%s\n", copy);
    }
    for (item in ints) {
        var str copy = item;
        printf("%d\n", copy);
    }
}

fn i32 main() {
    foo("Hamshik", "Shrinith", "Adi", 100, 200);
    return 0;
}
